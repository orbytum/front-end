# ===== Front-end =====
# As chamadas do navegador vão para /api. Em produção o nginx do container
# encaminha /api para http://api:8080 (ver nginx.conf); no `npm run dev` quem
# faz o proxy é o Vite.
VITE_BASE_URL=/api

# --- Apenas para `npm run dev` fora do Docker ---
# Destino do proxy /api quando o front roda direto na máquina.
VITE_PROXY_TARGET=http://localhost:18080

# Hosts aceitos pelo Vite (Cloudflare Tunnel + localhost).
VITE_ALLOWED_HOSTS=orbytum.luiz-antonio.site,.luiz-antonio.site,.trycloudflare.com,localhost,127.0.0.1

# HMR através do Cloudflare Tunnel (opcional). Descomente para ter hot reload no domínio público.
# VITE_HMR_HOST=orbytum.luiz-antonio.site
# VITE_HMR_PROTOCOL=wss
# VITE_HMR_CLIENT_PORT=443

# Docker Desktop (Mac/Windows) costuma precisar de polling: true
VITE_USE_POLLING=false

# ===== Docker Compose =====
# Caminho do repositório da API (relativo a este arquivo).
API_CONTEXT=../api

# Interface onde as portas são publicadas.
# 127.0.0.1 = apenas na máquina local (Cloudflare Tunnel rodando no host).
BIND_ADDRESS=127.0.0.1

# Porta do host para a API (8080 pode estar ocupado). Internamente segue 8080.
API_HOST_PORT=18080
# Porta do host para o front-end (o túnel deve apontar para ela).
# Dentro do container o nginx escuta na porta 80.
WEB_PORT=5173

# URL pública usada nos e-mails e nos links de arquivos gerados pela API.
FRONT_END_URL=https://orbytum.luiz-antonio.site
API_PUBLIC_URL=https://orbytum.luiz-antonio.site/api

# ===== Banco de dados =====
DB_NAME=admin
DB_USERNAME=admin
DB_PASSWORD=troque-esta-senha

# ===== Segurança da API =====
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-forte
JWT_EXPIRATION=86400000

# Conta de administrador inicial (criada só quando o banco está vazio).
INITIAL_ADMIN_EMAIL=admin.inicial@orbytum.com
# Gere com: openssl rand -hex 12
INITIAL_ADMIN_PASSWORD=troque-esta-senha

# ===== E-mail (convites) =====
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ===== Storage (S3 opcional; sem credenciais usa PostgreSQL) =====
AWS_REGION=sa-east-1
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_PROVIDER=auto
STORAGE_FALLBACK_ENABLED=true
STORAGE_MAX_FILE_SIZE_BYTES=20971520
